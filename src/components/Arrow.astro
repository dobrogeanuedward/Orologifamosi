---
interface Props {
  direction?: "out" | "down";
}
const { direction = "out" } = Astro.props;
---

<svg
  class:list={["ui-arrow", { "ui-arrow-down": direction === "down" }]}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width="20"
  height="20"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path
    d={direction === "down" ? "M12 5v14m-6-6 6 6 6-6" : "M6 18 18 6M6 6h12v12"}
  />
</svg>
