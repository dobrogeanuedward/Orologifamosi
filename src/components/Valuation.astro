---
import { brands, business, wa } from "../data/business";
const { brand = "" } = Astro.props;
---

<section
  class="valuation wrap"
  id="valutazione"
  aria-labelledby="valuation-title"
>
  <div class="valuation-copy">
    <h2 id="valuation-title">
      Cominciamo
      <br />
      dal tuo orologio.
    </h2>
    <p>Bastano poche informazioni per iniziare un confronto con Salvatore.</p>
    <div class="photo-guide">
      <div>
        <strong>Prepara anche qualche foto.</strong>
        <p>
          Quadrante, fondello, cassa e corredo, con luce naturale e senza
          filtri. Le allegherai direttamente nella chat WhatsApp.
        </p>
      </div>
    </div>
    <p class="micro">
      Non conosci modello o referenza? Scrivi ciò che sai.
      <br />
      Non serve aprire o smontare l’orologio.
    </p>
    <a class="text-link" href={business.phoneHref}>
      Preferisci parlarne? {business.phone}
    </a>
  </div>
  <div class="valuation-panel">
    <form novalidate id="valuation-form" data-brand={brand}>
      <div class="form-progress" data-ui aria-label="Avanzamento">
        <span class="active" data-indicator="0">
          1. Orologio
        </span>
        <span data-indicator="1">2. Dettagli</span>
        <span data-indicator="2">3. Riepilogo</span>
      </div>
      <p id="step-announcement" class="sr-only" aria-live="polite">
        Passaggio 1 di 3: Orologio
      </p>
      <fieldset data-step="0">
        <legend>Che orologio vuoi vendere?</legend>
        <label for="brand">Marchio</label>
        <select id="brand" name="brand" required>
          <option value="">Scegli il marchio</option>
          {brands.map((b) => (
            <option value={b} selected={b === brand}>
              {b}
            </option>
          ))}
        </select>
        <label for="model">
          Modello o referenza <span>(se li conosci)</span>
        </label>
        <input
          autocomplete="off"
          spellcheck="false"
          id="model"
          name="model"
          maxlength="120"
          placeholder="Es. Submariner 126610LN"
        />
        <p class="field-help">Puoi trovarli sulla garanzia o sui documenti.</p>
        <button class="button next" type="button">
          Continua <span aria-hidden="true">↗</span>
        </button>
      </fieldset>
      <fieldset data-step="1" hidden>
        <legend>Qualche dettaglio in più.</legend>
        <label for="condition">Condizioni</label>
        <select id="condition" name="condition" required>
          <option value="">Seleziona</option>
          <option>Ottime, pochi segni d’uso</option>
          <option>Usato, con segni visibili</option>
          <option>Da revisionare o non funzionante</option>
          <option>Da verificare insieme</option>
        </select>
        <label for="set">Scatola e documenti</label>
        <select id="set" name="set" required>
          <option value="">Seleziona</option>
          <option>Scatola e documenti</option>
          <option>Solo scatola</option>
          <option>Solo documenti</option>
          <option>Nessuno dei due</option>
          <option>Non so, da verificare</option>
        </select>
        <label for="notes">
          C’è altro da sapere? <span>(facoltativo)</span>
        </label>
        <textarea
          autocomplete="off"
          id="notes"
          name="notes"
          maxlength="600"
          rows="3"
          placeholder="Anno, revisioni, accessori, eventuali difetti…"
        ></textarea>
        <div class="form-actions">
          <button class="back" type="button">
            Indietro
          </button>
          <button class="button next" type="button">
            Vedi riepilogo <span aria-hidden="true">↗</span>
          </button>
        </div>
      </fieldset>
      <fieldset data-step="2" hidden>
        <legend>Pronto per parlarne?</legend>
        <dl id="request-summary"></dl>
        <p class="field-help">
          Apriremo WhatsApp con il messaggio preparato. Controllalo, allega le
          foto e premi invia nella chat.
        </p>
        <p class="micro">
          Nessun dato viene inviato da questo modulo. La richiesta verrà
          ricevuta solo quando la invierai su WhatsApp.{" "}
          <a href={business.privacy} target="_blank" rel="noopener noreferrer">
            Leggi l’informativa privacy
          </a>
          .
        </p>
        <div class="form-actions">
          <button class="back" type="button">
            Modifica
          </button>
          <button class="button whatsapp-submit" type="submit">
            Apri WhatsApp <span aria-hidden="true">↗</span>
          </button>
        </div>
        <p class="micro">
          Nessun obbligo di vendita. Nessuna valutazione automatica.
        </p>
      </fieldset>
    </form>
    <noscript>
      <style>
        #valuation-form {
          display: none;
        }
      </style>
      <p>
        Per richiedere una valutazione, scrivi direttamente a Salvatore con
        marca, modello e condizioni del tuo orologio.
      </p>
      <a
        class="button"
        href={wa(
          "Buongiorno Salvatore, vorrei richiedere una valutazione per il mio " +
            (brand || "orologio") +
            ".",
        )}
      >
        Scrivi su WhatsApp
      </a>
    </noscript>
  </div>
</section>
<script>
  import { buildRequest } from "../lib/request.mjs";
  const form = document.querySelector<HTMLFormElement>("#valuation-form");
  if (form) {
    const steps = Array.from(
      form.querySelectorAll<HTMLFieldSetElement>("[data-step]"),
    );
    let current = 0;
    const read = () => Object.fromEntries(new FormData(form).entries());
    const show = (n: number) => {
      current = n;
      steps.forEach((s, i) => (s.hidden = i !== n));
      form
        .querySelectorAll("[data-indicator]")
        .forEach((e, i) => e.classList.toggle("active", i <= n));
      const announcement = document.querySelector("#step-announcement");
      if (announcement)
        announcement.textContent = `Passaggio ${n + 1} di 3: ${["Orologio", "Dettagli", "Riepilogo"][n]}`;
      if (n === 2) {
        const data = read(),
          summary = form.querySelector("#request-summary");
        summary?.replaceChildren();
        for (const [label, value] of [
          ["Marchio", data.brand],
          ["Modello", data.model || "Da identificare"],
          ["Condizioni", data.condition],
          ["Corredo", data.set],
          ["Note", data.notes],
        ]) {
          if (!value) continue;
          const dt = document.createElement("dt"),
            dd = document.createElement("dd");
          dt.textContent = String(label);
          dd.textContent = String(value);
          summary?.append(dt, dd);
        }
      }
      const legend = steps[n]?.querySelector("legend");
      legend?.setAttribute("tabindex", "-1");
      legend?.focus({ preventScroll: true });
    };
    form.querySelectorAll(".next").forEach((b) =>
      b.addEventListener("click", () => {
        const fields = Array.from(
          steps[current].querySelectorAll<HTMLInputElement | HTMLSelectElement>(
            "input,select,textarea",
          ),
        );
        const invalid = fields.find((f) => !f.checkValidity());
        if (invalid) {
          invalid.reportValidity();
          return;
        }
        show(current + 1);
      }),
    );
    form
      .querySelectorAll(".back")
      .forEach((b) => b.addEventListener("click", () => show(current - 1)));
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      if (current !== 2) {
        steps[current].querySelector<HTMLButtonElement>(".next")?.click();
        return;
      }
      const url = buildRequest(read());
      document.dispatchEvent(
        new CustomEvent("orologi:action", {
          detail: { name: "whatsapp_open", page: location.pathname },
        }),
      );
      window.location.assign(url);
    });
  }
</script>
