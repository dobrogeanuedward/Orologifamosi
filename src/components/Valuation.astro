---
import Arrow from "./Arrow.astro";
import RequestIcon from "./RequestIcon.astro";
import RequestIllustration from "./RequestIllustration.astro";
import { OTHER_BRAND } from "../lib/request.mjs";
import { brands, business, wa } from "../data/business";
import "../styles/valuation.css";
const { brand = "" } = Astro.props;
const conditions = [
  ["Ottime", "Ottime, pochi segni d’uso", "watch"],
  ["Usato", "Usato, con segni visibili", "used"],
  ["Da revisionare", "Da revisionare o non funzionante", "service"],
  ["Da verificare", "Da verificare insieme", "inspection"],
] as const;
const sets = [
  ["Completo", "Scatola e documenti", "complete"],
  ["Solo scatola", "Solo scatola", "box"],
  ["Solo documenti", "Solo documenti", "documents"],
  ["Senza corredo", "Nessuno dei due", "watch"],
  ["Da verificare", "Non so, da verificare", "inspection"],
] as const;
---

<section
  class="request-workbench wrap"
  id="valutazione"
  aria-labelledby="valuation-title"
>
  <div class="request-story">
    <p class="brand-eyebrow">La richiesta, fatta bene</p>
    <h2 id="valuation-title">
      Il tuo orologio.
      <br />
      Tutti i dettagli.
    </h2>
    <p>
      Raccontalo, aggiungi le foto e controlla il messaggio prima di
      condividerlo con Salvatore.
    </p>
    <div class="request-passport" aria-label="Anteprima della tua scheda">
      <div class="passport-top">
        <span>Orologi Famosi</span>
        <span>La tua scheda</span>
      </div>
      <div class="passport-watch">
        <div class="passport-photo">
          <RequestIllustration name="watch" />
          <img
            id="passport-image"
            alt="Prima foto della tua selezione"
            width="120"
            height="120"
            hidden
          />
        </div>
        <div>
          <strong id="passport-brand">{brand || "Il tuo orologio"}</strong>
          <p id="passport-model">Modello da conoscere</p>
        </div>
      </div>
      <dl>
        <div>
          <dt>Condizioni</dt>
          <dd id="passport-condition">Da specificare</dd>
        </div>
        <div>
          <dt>Corredo</dt>
          <dd id="passport-set">Da specificare</dd>
        </div>
        <div>
          <dt>Fotografie</dt>
          <dd id="passport-photos">Nessuna selezionata</dd>
        </div>
      </dl>
      <div class="passport-bottom">
        <span>Bozza sul tuo dispositivo</span>
        <span id="passport-reference"></span>
      </div>
    </div>
    <p class="request-assurance">
      Nessuna stima automatica.
      <br />
      Nessun obbligo di vendita.
    </p>
    <a class="text-link" href={business.phoneHref}>
      Preferisci parlarne? Chiama Salvatore <Arrow />
    </a>
  </div>
  <div class="request-workspace">
    <div class="request-workspace-top">
      <span class="request-dot" aria-hidden="true"></span>
      <span>La tua richiesta di valutazione</span>
      <span id="request-step-count">01 / 04</span>
    </div>
    <form novalidate id="valuation-form" data-brand={brand}>
      <ol class="request-stages" aria-label="Passaggi della richiesta">
        {["Orologio", "Dettagli", "Foto", "Invio"].map((label, i) => (
          <li
            data-indicator={i}
            class:list={[{ active: i === 0 }]}
            aria-current={i === 0 ? "step" : undefined}
          >
            <span aria-hidden="true">{i + 1}</span>
            {label}
          </li>
        ))}
      </ol>
      <p id="step-announcement" class="sr-only" aria-live="polite">
        Passaggio 1 di 4: Orologio
      </p>
      <fieldset class="request-step" data-step="0">
        <legend>Partiamo dal tuo orologio.</legend>
        <p class="request-step-intro">
          Scegli il marchio. Se non conosci il modello, puoi lasciare il campo
          vuoto.
        </p>
        <div
          class="request-brand-shortcuts"
          aria-label="Selezione rapida del marchio"
        >
          {["Rolex", "Omega", "Cartier"].map((b) => (
            <button
              type="button"
              data-brand-choice={b}
              aria-pressed={brand === b ? "true" : "false"}
            >
              {b}
            </button>
          ))}
        </div>
        <label for="brand">Marchio</label>
        <select id="brand" name="brand" required>
          <option value="">Scegli il marchio</option>
          {brands.map((b) => (
            <option value={b} selected={b === brand}>
              {b}
            </option>
          ))}
          <option value={OTHER_BRAND}>Un altro marchio</option>
        </select>
        <div id="other-brand-field" class="request-other-brand" hidden>
          <label for="other-brand">Qual è il marchio?</label>
          <input
            id="other-brand"
            name="otherBrand"
            autocomplete="off"
            spellcheck="false"
            maxlength="80"
            placeholder="Scrivi il nome del marchio"
            aria-describedby="other-brand-help"
            disabled
          />
          <p id="other-brand-help" class="request-field-note">
            Indica il nome riportato sul quadrante o sui documenti.
          </p>
        </div>
        <label for="model">
          Modello o referenza <span>(se li conosci)</span>
        </label>
        <input
          id="model"
          name="model"
          autocomplete="off"
          spellcheck="false"
          maxlength="120"
          placeholder="Es. Submariner 126610LN"
        />
        <p class="request-field-note">
          La referenza può essere sui documenti. Non serve smontare l’orologio.
        </p>
        <button class="button next" type="button">
          Continua{" "}
          <span>
            <Arrow />
          </span>
        </button>
      </fieldset>
      <fieldset class="request-step" data-step="1" hidden>
        <legend>Com’è il tuo esemplare?</legend>
        <p class="request-step-intro">
          Anche ciò che manca o va controllato ci aiuta a conoscerlo meglio.
        </p>
        <fieldset class="request-option-group">
          <legend>Condizioni</legend>
          <div class="request-options">
            {conditions.map(([label, value, illustration], i) => (
              <label>
                <input
                  type="radio"
                  name="condition"
                  value={value}
                  required={i === 0}
                />
                <span>
                  <RequestIllustration name={illustration} />
                  {label}
                </span>
              </label>
            ))}
          </div>
        </fieldset>
        <fieldset class="request-option-group">
          <legend>Scatola e documenti</legend>
          <div class="request-options request-set-options">
            {sets.map(([label, value, illustration], i) => (
              <label>
                <input
                  type="radio"
                  name="set"
                  value={value}
                  required={i === 0}
                />
                <span>
                  <RequestIllustration name={illustration} />
                  {label}
                </span>
              </label>
            ))}
          </div>
        </fieldset>
        <label for="notes">
          C’è altro da sapere? <span>(facoltativo)</span>
        </label>
        <textarea
          id="notes"
          name="notes"
          autocomplete="off"
          maxlength="600"
          rows="3"
          placeholder="Anno, revisioni, accessori, eventuali difetti…"
        ></textarea>
        <div class="request-actions">
          <button class="request-back back" type="button">
            Indietro
          </button>
          <button class="button next" type="button">
            Aggiungi le foto{" "}
            <span>
              <Arrow />
            </span>
          </button>
        </div>
      </fieldset>
      <fieldset class="request-step" data-step="2" hidden>
        <legend>Facciamolo vedere bene.</legend>
        <p class="request-step-intro">
          Aggiungi foto dell’orologio, dei dettagli e del corredo. Puoi iniziare
          la richiesta anche senza foto.
        </p>
        <div class="request-shot-guide" id="foto">
          <span>
            <RequestIllustration name="watch" />
            Quadrante
          </span>
          <span>
            <RequestIllustration name="used" />
            Lati e fondello
          </span>
          <span>
            <RequestIllustration name="complete" />
            Corredo
          </span>
        </div>
        <div id="photo-dropzone" class="request-upload-zone">
          <label class="request-file-picker">
            <input
              id="watch-photos"
              class="sr-only"
              type="file"
              accept="image/jpeg,image/png,image/webp,image/heic,image/heif"
              multiple
              aria-describedby="photo-file-help photo-local-note"
            />
            <RequestIcon name="camera" />
            <strong>Aggiungi le foto</strong>
            <span>
              Scegli dalla galleria
              <span class="desktop-drop-hint"> o trascinale qui</span>
            </span>
          </label>
          <label class="request-capture-picker">
            <input
              id="watch-camera"
              class="sr-only"
              type="file"
              accept="image/jpeg,image/png,image/webp,image/heic,image/heif"
              capture="environment"
            />
            <RequestIcon name="camera" />
            Usa la fotocamera
          </label>
        </div>
        <p class="request-field-note" id="photo-file-help">
          JPEG, PNG, WebP e HEIC leggibile dal dispositivo. Originali fino a
          20 MB per foto. Li ottimizziamo qui: il limite totale di 40 MB si
          applica alle foto già preparate.
        </p>
        <p
          id="photo-progress"
          class="request-photo-status"
          role="status"
          aria-live="polite"
        ></p>
        <p id="photo-errors" class="request-photo-error" role="alert"></p>
        <ul
          id="photo-preview-list"
          class="request-photo-grid"
          aria-label="Foto selezionate"
        ></ul>
        <p class="request-local-note" id="photo-local-note">
          Le foto restano qui finché non scegli di condividerle. Ricaricando la
          pagina, la selezione si perde.
        </p>
        <div class="request-actions">
          <button class="request-back back" type="button">
            Indietro
          </button>
          <button class="button next" type="button">
            Controlla la richiesta{" "}
            <span>
              <Arrow />
            </span>
          </button>
        </div>
      </fieldset>
      <fieldset class="request-step request-finish" data-step="3" hidden>
        <legend>La tua richiesta è pronta.</legend>
        <p class="request-step-intro">
          Controlla i dettagli e scegli come iniziare il confronto.
        </p>
        <div class="request-final-heading">
          <span>Il tuo orologio</span>
          <button type="button" class="request-edit" data-edit-step="0">
            Modifica
          </button>
        </div>
        <dl id="request-summary"></dl>
        <div class="request-final-heading">
          <span id="request-photo-summary">Nessuna foto selezionata</span>
          <button type="button" class="request-edit" data-edit-step="2">
            Modifica foto
          </button>
        </div>
        <div id="request-final-photos" class="request-final-photos"></div>
        <div class="request-recipient">
          <span class="request-recipient-monogram" aria-hidden="true">
            SA
          </span>
          <div>
            <strong>Salvatore Agresta</strong>
            <span>{business.phone}</span>
          </div>
          <button
            type="button"
            class="request-copy-number"
            aria-label="Copia il numero di Salvatore"
          >
            Copia numero
          </button>
        </div>
        <div id="request-share-files" hidden>
          <button class="button" id="share-photos" type="button">
            <RequestIcon name="share" />
            Condividi foto e richiesta{" "}
            <span>
              <Arrow />
            </span>
          </button>
          <p class="request-field-note request-share-help">
            Scegli WhatsApp nel pannello di condivisione, poi Salvatore. Se il
            testo non compare con le foto, apri anche il messaggio pronto qui
            sotto.
          </p>
        </div>
        <div id="request-direct-route">
          <button class="button whatsapp-submit" type="submit" id="direct-chat">
            Apri la chat di Salvatore{" "}
            <span>
              <Arrow />
            </span>
          </button>
          <p id="request-delivery-note" class="request-field-note">
            La chat si aprirà con il testo preparato. Il messaggio parte solo
            quando premi invia in WhatsApp.
          </p>
        </div>
        <button type="button" id="copy-request" class="request-copy-message">
          Copia il testo della richiesta
        </button>
        <p
          id="request-delivery-status"
          class="request-photo-status"
          role="status"
          aria-live="polite"
        ></p>
        <details class="request-message-preview">
          <summary>
            Leggi il messaggio preparato <span aria-hidden="true">+</span>
          </summary>
          <pre id="request-message"></pre>
        </details>
        <p class="request-local-note">
          La selezione delle foto non invia nulla a Salvatore. Per completare la
          richiesta, condividi le foto e invia il messaggio.{" "}
          <a href={business.privacy} target="_blank" rel="noopener noreferrer">
            Informativa privacy
          </a>
          .
        </p>
        <button class="request-back back" type="button">
          Torna alle foto
        </button>
      </fieldset>
    </form>
    <template id="request-photo-template">
      <li class="request-photo-card">
        <button type="button" class="request-photo-open">
          <img alt="" width="220" height="180" />
        </button>
        <div>
          <span class="request-photo-label"></span>
          <span class="request-photo-size"></span>
        </div>
        <button type="button" class="request-photo-remove">
          <RequestIcon name="close" />
        </button>
        <a class="request-photo-save">
          <RequestIcon name="download" />
        </a>
      </li>
    </template>
    <dialog
      class="request-photo-dialog"
      id="request-photo-viewer"
      aria-label="Anteprima della foto"
    >
      <div class="request-viewer-top">
        <span id="request-viewer-caption" aria-live="polite"></span>
        <button
          type="button"
          class="request-viewer-close"
          aria-label="Chiudi anteprima"
        >
          <RequestIcon name="close" />
        </button>
      </div>
      <img id="request-viewer-image" alt="" width="1200" height="1000" />
      <div class="request-viewer-controls">
        <button type="button" data-viewer-previous>
          Foto precedente
        </button>
        <button type="button" data-viewer-next>
          Foto successiva
        </button>
      </div>
    </dialog>
    <noscript>
      <style>
        #valuation-form {
          display: none;
        }
      </style>
      <p>
        Scrivi a Salvatore con marca, modello e condizioni del tuo orologio.
        Puoi allegare le foto direttamente in WhatsApp.
      </p>
      <a
        class="button"
        href={wa(
          "Buongiorno Salvatore, vorrei richiedere una valutazione per il mio " +
            (brand || "orologio") +
            ".",
        )}
      >
        Scrivi su WhatsApp
      </a>
    </noscript>
  </div>
</section>
<script>
  import "../lib/valuation";
</script>
