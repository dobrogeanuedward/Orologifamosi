---
interface Props {
  name?:
    | "camera"
    | "watch"
    | "box"
    | "share"
    | "close"
    | "download"
    | "check"
    | "phone"
    | "pin";
}
const { name = "camera" } = Astro.props;
const paths = {
  camera: "M4 7h4l2-3h4l2 3h4v13H4z M16 13a4 4 0 1 1-8 0 4 4 0 0 1 8 0",
  watch:
    "M8 3h8l1 4v10l-1 4H8l-1-4V7z M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0 M12 9v3l2 1",
  box: "m3 7 9-4 9 4-9 4-9-4v10l9 4 9-4V7 M12 11v10 M7 5l10 4",
  share: "M12 16V3 M7 8l5-5 5 5 M5 12v9h14v-9",
  close: "m6 6 12 12 M18 6 6 18",
  download: "M12 3v13 M7 11l5 5 5-5 M4 17v4h16v-4",
  check: "m5 12 4 4L19 6",
  phone: "M7 3 4 5c0 8 7 15 15 15l2-3-5-4-2 2c-3-1-5-3-6-6l2-2z",
  pin: "M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 1 1 14 0 M15 10a3 3 0 1 1-6 0 3 3 0 0 1 6 0",
};
---

<svg
  class="request-icon"
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
