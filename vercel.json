{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/vendi-orologio/",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/of-assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "build": {
    "env": {
      "DESK_URL": "https://dogo-desk.vercel.app",
      "TURNSTILE_SITE_KEY": "0x4AAAAAAGA0qU7O7kF68l0V"
    }
  }
}
